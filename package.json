{
  "name": "flowgoogle2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible image API proxy for flow.google.com",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "fastify": "^5.2.0",
    "playwright-core": "1.49.1",
    "undici": "^7.2.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20"
  }
}
