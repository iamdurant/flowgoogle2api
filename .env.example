# downstream api key (required in production)
AUTH_KEY=change-me

# listening address
PORT=3000
HOST=0.0.0.0

# outbound proxy for flow.google.com (optional but usually required in CN)
FLOW_PROXY=http://127.0.0.1:10808

# absolute base url returned in image links (optional; defaults to http://127.0.0.1:PORT)
PUBLIC_BASE_URL=

# defaults
DEFAULT_MODEL=nano-banana-pro
DEFAULT_ASPECT=16:9
DEFAULT_2K=true

# concurrency
WORKERS_PER_ACCOUNT=2
MAX_CONCURRENCY=4
QUEUE_TIMEOUT_MS=120000

# headless chrome for reCAPTCHA minting (set false to watch it work)
CHROME_HEADLESS=true

# optional: attach to an already running Chrome instead of launching one.
# leave empty in production (a headless Chrome is launched automatically).
CHROME_CDP_URL=

ACCOUNTS_FILE=data/accounts.json
IMAGE_DIR=data/images
IMAGE_TTL_MS=3600000