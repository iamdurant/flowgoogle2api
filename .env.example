# downstream API key (required in production)
AUTH_KEY=change-me

# listening address
PORT=3000
HOST=0.0.0.0

# outbound proxy for flow.google.com (optional, usually required in CN)
FLOW_PROXY=

# absolute base url used in image links (e.g. https://img.example.com)
PUBLIC_BASE_URL=

# defaults
DEFAULT_MODEL=nano-banana-pro
DEFAULT_ASPECT=16:9
DEFAULT_2K=true

# direct ogiZ0b RPC handles every aspect ratio; the agent channel (WebChannel)
# is slower and gets rate-limited upstream, so it is off by default
AGENT_MODE=false

# concurrency: worker tabs per account and the global in-flight limit
WORKERS_PER_ACCOUNT=3
MAX_CONCURRENCY=8
QUEUE_TIMEOUT_MS=120000
GENERATE_TIMEOUT_MS=180000

# headless Chrome that hosts the flow.google.com tabs (set false to watch it)
CHROME_HEADLESS=true

# optional: attach to an already running Chrome instead of launching one
CHROME_CDP_URL=

# runtime data
ACCOUNTS_FILE=data/accounts.json
STATS_FILE=data/stats.json
LOGS_FILE=data/logs.jsonl
IMAGE_DIR=data/images
IMAGE_TTL_MS=3600000
